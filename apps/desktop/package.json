{
  "name": "@robot/desktop",
  "private": true,
  "type": "module",
  "version": "0.1.0-alpha.9",
  "main": "out/main/index.js",
  "scripts": {
    "build:host": "cargo build --release --locked --manifest-path ../../host/Cargo.toml",
    "dev": "bun run build:host && electron-vite dev",
    "build": "bun run build:host && electron-vite build",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "bun run build && playwright test",
    "postinstall": "install-electron",
    "licenses": "bun scripts/licenses.ts",
    "dist": "bun run build && electron-builder --publish never"
  },
  "dependencies": {},
  "bundled": [
    "@robot/link",
    "@robot/shared",
    "effect",
    "fflate",
    "lucide-solid",
    "marked",
    "multicast-dns",
    "solid-js",
    "uqr",
    "ws"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@robot/link": "workspace:*",
    "@robot/phone": "workspace:*",
    "@robot/shared": "workspace:*",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "24",
    "@types/ws": "^8.18.2",
    "effect": "^4.1.1",
    "electron": "^45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.66.0",
    "marked": "^18.1.2",
    "multicast-dns": "^7.2.5",
    "solid-js": "^1.9.18",
    "uqr": "^0.1.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "ws": "^8.22.1"
  },
  "productName": "ROBot",
  "description": "A desktop app where you work with AI agents.",
  "author": "zereight",
  "license": "MIT",
  "homepage": "https://github.com/zereight/robot"
}
