{
  "name": "robot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --parallel --pass-with-no-tests packages apps/desktop/src apps/desktop/scripts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "e2e": "bun run --cwd apps/desktop e2e",
    "dist": "bun run --cwd apps/desktop dist",
    "version": "bun apps/desktop/scripts/version.ts",
    "sizes": "bun apps/desktop/scripts/sizes.ts",
    "perf": "bun apps/desktop/scripts/perf.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
