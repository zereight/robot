#!/bin/sh
# Take AI co-author trailers out of the commit message (AGENTS.md: "Never add AI co-author
# trailers to commits"). A tool can add one to the message after the author writes it, and
# "git commit --amend" keeps it, so the message is cleaned here, at the last point before the
# commit is made.
#
# A trailer for a person stays. Only the names and mail addresses of the coding tools are
# dropped. The message is written back as it was, apart from those lines and the blank lines
# that held them apart from the text.
#
# The commit is never stopped: a failure here leaves the message as it was, and the commit goes
# ahead. "git commit --no-verify" skips this hook.

msg=$1
[ -n "$msg" ] || exit 0
[ -f "$msg" ] || exit 0

# The names and the mail addresses of the tools that write code. A line is dropped when it is a
# "Co-authored-by" trailer and it names one of them.
tools='cursor|copilot|anthropic|claude|openai|chatgpt|codex|gemini|devin|windsurf|codeium|tabnine|sourcegraph'

kept=$(mktemp 2>/dev/null) || exit 0
trap 'rm -f "$kept"' EXIT INT TERM

# -i folds the case, so "Cursor" and "cursoragent@cursor.com" both match.
if ! grep -viE "^[[:space:]]*co-authored-by:.*($tools)" "$msg" >"$kept" 2>/dev/null; then
  # grep exits 1 when every line matched, and the file is empty. That is not an error here.
  :
fi

# An empty message would stop the commit, and a message of trailers only is not a message.
if [ ! -s "$kept" ] || ! grep -qvE '^[[:space:]]*$' "$kept" 2>/dev/null; then
  exit 0
fi

# The trailers sat after a blank line, so the text now ends in blank lines. Drop them.
trimmed=$(mktemp 2>/dev/null) || exit 0
trap 'rm -f "$kept" "$trimmed"' EXIT INT TERM
awk '{ line[NR] = $0 } END {
  last = NR
  while (last > 0 && line[last] ~ /^[[:space:]]*$/) last--
  for (i = 1; i <= last; i++) print line[i]
}' "$kept" >"$trimmed" 2>/dev/null || exit 0

cat "$trimmed" >"$msg" 2>/dev/null || exit 0
exit 0
